ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('columns-offset.ifc','2026-11-07T00:00:00',(''),(''),'hand-written test fixture','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* units: millimetre, radian */
#1=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaa1',$,'Columns and Offset Test',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#30,$,$);
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCDIRECTION((0.,0.,1.));
#32=IFCDIRECTION((1.,0.,0.));
#33=IFCDIRECTION((0.,1.,0.));
#34=IFCDIRECTION((-1.,0.,0.));
#35=IFCDIRECTION((0.,-1.,0.));

/* site, building, storeys */
#40=IFCSITE('0aaaaaaaaaaaaaaaaaaaa2',$,'Site',$,$,#41,$,$,.ELEMENT.,$,$,$,$,$);
#41=IFCLOCALPLACEMENT($,#42);
#42=IFCAXIS2PLACEMENT3D(#30,$,$);
#44=IFCBUILDING('0aaaaaaaaaaaaaaaaaaaa3',$,'Building',$,$,#45,$,$,.ELEMENT.,$,$,$);
#45=IFCLOCALPLACEMENT(#41,#21);
#50=IFCBUILDINGSTOREY('0aaaaaaaaaaaaaaaaaaaa4',$,'Level 1',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#45,#21);
#52=IFCBUILDINGSTOREY('0aaaaaaaaaaaaaaaaaaaa5',$,'Level 2',$,$,#53,$,$,.ELEMENT.,3000.);
#53=IFCLOCALPLACEMENT(#45,#54);
#54=IFCAXIS2PLACEMENT3D(#55,$,$);
#55=IFCCARTESIANPOINT((0.,0.,3000.));

#60=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa6',$,$,$,#1,(#40));
#61=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa7',$,$,$,#40,(#44));
#62=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa8',$,$,$,#44,(#50,#52));

#64=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab1',$,$,$,(#100,#120,#200,#210,#220,#310),#50);
#65=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab2',$,$,$,(#110,#300),#52);

/* 1. Ordinary wall on Level 1: 4000x200, extruded 3000 tall, Z 0..3000 */
#100=IFCWALL('0aaaaaaaaaaaaaaaaaaac1',$,'Ordinary Wall',$,$,#101,#102,$,.STANDARD.);
#101=IFCLOCALPLACEMENT(#51,#21);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103,#106));
#103=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#104));
#104=IFCPOLYLINE((#105,#1051));
#105=IFCCARTESIANPOINT((0.,0.));
#1051=IFCCARTESIANPOINT((4000.,0.));
#106=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#107));
#107=IFCEXTRUDEDAREASOLID(#108,#21,#31,3000.);
#108=IFCRECTANGLEPROFILEDEF(.AREA.,$,#109,4000.,200.);
#109=IFCAXIS2PLACEMENT2D(#1091,$);
#1091=IFCCARTESIANPOINT((2000.,0.));

/* 2. Negative offset wall: contained in Level 2, but Z 0..2800 (offset -3000 from Level 2) */
#110=IFCWALL('0aaaaaaaaaaaaaaaaaaac2',$,'Negative Offset Wall',$,$,#111,#112,$,.STANDARD.);
#111=IFCLOCALPLACEMENT(#53,#1111);
#1111=IFCAXIS2PLACEMENT3D(#1112,$,$);
#1112=IFCCARTESIANPOINT((0.,2000.,-3000.));
#112=IFCPRODUCTDEFINITIONSHAPE($,$,(#113,#116));
#113=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#114));
#114=IFCPOLYLINE((#105,#1141));
#1141=IFCCARTESIANPOINT((5000.,0.));
#116=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#117));
#117=IFCEXTRUDEDAREASOLID(#118,#21,#31,2800.);
#118=IFCRECTANGLEPROFILEDEF(.AREA.,$,#119,5000.,200.);
#119=IFCAXIS2PLACEMENT2D(#1191,$);
#1191=IFCCARTESIANPOINT((2500.,0.));

/* 3. 2-storey wall contained in Level 1, Z 0..6000 */
#120=IFCWALL('0aaaaaaaaaaaaaaaaaaac3',$,'Two Storey Wall',$,$,#121,#122,$,.STANDARD.);
#121=IFCLOCALPLACEMENT(#51,#1211);
#1211=IFCAXIS2PLACEMENT3D(#1212,$,$);
#1212=IFCCARTESIANPOINT((0.,4000.,0.));
#122=IFCPRODUCTDEFINITIONSHAPE($,$,(#123,#126));
#123=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#124));
#124=IFCPOLYLINE((#105,#1241));
#1241=IFCCARTESIANPOINT((7000.,0.));
#126=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#127));
#127=IFCEXTRUDEDAREASOLID(#128,#21,#31,6000.);
#128=IFCRECTANGLEPROFILEDEF(.AREA.,$,#129,7000.,200.);
#129=IFCAXIS2PLACEMENT2D(#1291,$);
#1291=IFCCARTESIANPOINT((3500.,0.));

/* 4. Rectangular column 300x500 mm, Z 0..6000 */
#200=IFCCOLUMN('0aaaaaaaaaaaaaaaaaaad1',$,'Rect Column',$,$,#201,#202,$,.COLUMN.);
#201=IFCLOCALPLACEMENT(#51,#2011);
#2011=IFCAXIS2PLACEMENT3D(#2012,$,$);
#2012=IFCCARTESIANPOINT((1000.,6000.,0.));
#202=IFCPRODUCTDEFINITIONSHAPE($,$,(#203));
#203=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#204));
#204=IFCEXTRUDEDAREASOLID(#205,#21,#31,6000.);
#205=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,300.,500.);

/* 5. Circular column radius 200 mm, Z 0..3000 */
#210=IFCCOLUMN('0aaaaaaaaaaaaaaaaaaad2',$,'Round Column',$,$,#211,#212,$,.COLUMN.);
#211=IFCLOCALPLACEMENT(#51,#2111);
#2111=IFCAXIS2PLACEMENT3D(#2112,$,$);
#2112=IFCCARTESIANPOINT((3000.,6000.,0.));
#212=IFCPRODUCTDEFINITIONSHAPE($,$,(#213));
#213=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#214));
#214=IFCEXTRUDEDAREASOLID(#215,#21,#31,3000.);
#215=IFCCIRCLEPROFILEDEF(.AREA.,$,$,200.);

/* 6. Proxy 'Generic Box': 1000x600 rectangle, Z 500..1400 on Level 1 */
#220=IFCBUILDINGELEMENTPROXY('0aaaaaaaaaaaaaaaaaaae1',$,'Generic Box',$,$,#221,#222,$,.ELEMENT.);
#221=IFCLOCALPLACEMENT(#51,#2211);
#2211=IFCAXIS2PLACEMENT3D(#2212,$,$);
#2212=IFCCARTESIANPOINT((5000.,6000.,500.));
#222=IFCPRODUCTDEFINITIONSHAPE($,$,(#223));
#223=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#224));
#224=IFCEXTRUDEDAREASOLID(#225,#21,#31,900.);
#225=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1000.,600.);

/* 7. IfcRailing 'Balcony Railing' on Level 2: 2000x50 mm, Z 3000..4100 */
#300=IFCRAILING('0aaaaaaaaaaaaaaaaaaaf1',$,'Balcony Railing',$,$,#301,#302,$,.USERDEFINED.);
#301=IFCLOCALPLACEMENT(#53,#3011);
#3011=IFCAXIS2PLACEMENT3D(#3012,$,$);
#3012=IFCCARTESIANPOINT((0.,8000.,0.));
#302=IFCPRODUCTDEFINITIONSHAPE($,$,(#303,#306));
#303=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#304));
#304=IFCPOLYLINE((#105,#3041));
#3041=IFCCARTESIANPOINT((2000.,0.));
#306=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#307));
#307=IFCEXTRUDEDAREASOLID(#308,#21,#31,1100.);
#308=IFCRECTANGLEPROFILEDEF(.AREA.,$,#309,2000.,50.);
#309=IFCAXIS2PLACEMENT2D(#3091,$);
#3091=IFCCARTESIANPOINT((1000.,0.));

/* 8. Proxy 'Railing:Glass' on Level 1: 1500x20 mm, Z 0..1100 */
#310=IFCBUILDINGELEMENTPROXY('0aaaaaaaaaaaaaaaaaaaf2',$,'Railing:Glass',$,$,#311,#312,$,.ELEMENT.);
#311=IFCLOCALPLACEMENT(#51,#3111);
#3111=IFCAXIS2PLACEMENT3D(#3112,$,$);
#3112=IFCCARTESIANPOINT((0.,10000.,0.));
#312=IFCPRODUCTDEFINITIONSHAPE($,$,(#313,#316));
#313=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#314));
#314=IFCPOLYLINE((#105,#3141));
#3141=IFCCARTESIANPOINT((1500.,0.));
#316=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#317));
#317=IFCEXTRUDEDAREASOLID(#318,#21,#31,1100.);
#318=IFCRECTANGLEPROFILEDEF(.AREA.,$,#319,1500.,20.);
#319=IFCAXIS2PLACEMENT2D(#3191,$);
#3191=IFCCARTESIANPOINT((750.,0.));

ENDSEC;
END-ISO-10303-21;
