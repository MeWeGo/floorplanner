ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('roof-stairs.ifc','2026-11-07T00:00:00',(''),(''),'hand-written test fixture','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* units: millimetre, radian */
#1=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaa1',$,'Roof Stairs House',$,$,'Roof Stairs House',$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#30,$,$);
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCDIRECTION((0.,0.,1.));
#32=IFCDIRECTION((1.,0.,0.));
#33=IFCDIRECTION((0.,1.,0.));
#34=IFCDIRECTION((-1.,0.,0.));
#35=IFCDIRECTION((0.,-1.,0.));

/* Spatial hierarchy: Site -> Building -> (Ground, Upper) */
#40=IFCSITE('0aaaaaaaaaaaaaaaaaaaa2',$,'Site',$,$,#41,$,$,.ELEMENT.,$,$,$,$,$);
#41=IFCLOCALPLACEMENT($,#21);
#44=IFCBUILDING('0aaaaaaaaaaaaaaaaaaaa3',$,'Building',$,$,#45,$,$,.ELEMENT.,$,$,$);
#45=IFCLOCALPLACEMENT(#41,#21);
#50=IFCBUILDINGSTOREY('0aaaaaaaaaaaaaaaaaaaa4',$,'Ground',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#45,#21);
#52=IFCBUILDINGSTOREY('0aaaaaaaaaaaaaaaaaaaa5',$,'Upper',$,$,#53,$,$,.ELEMENT.,3000.);
#53=IFCLOCALPLACEMENT(#45,#54);
#54=IFCAXIS2PLACEMENT3D(#55,$,$);
#55=IFCCARTESIANPOINT((0.,0.,3000.));

#60=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa6',$,$,$,#1,(#40));
#61=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa7',$,$,$,#40,(#44));
#62=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa8',$,$,$,#44,(#50,#52));
#63=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab1',$,$,$,(#100,#110,#120,#130,#300),#50);
#64=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab2',$,$,$,(#140,#150,#160,#170,#200),#52);

/* Ground walls: 6000x4000, 3000 tall, 200 thick */
#100=IFCWALL('0aaaaaaaaaaaaaaaaaaac1',$,'Wall G1',$,$,#51,#102,$,.STANDARD.);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103,#106));
#103=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#104));
#104=IFCPOLYLINE((#105,#1051));
#105=IFCCARTESIANPOINT((0.,0.));
#1051=IFCCARTESIANPOINT((6000.,0.));
#106=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#107));
#107=IFCEXTRUDEDAREASOLID(#108,#21,#31,3000.);
#108=IFCRECTANGLEPROFILEDEF(.AREA.,$,#109,6000.,200.);
#109=IFCAXIS2PLACEMENT2D(#1091,$);
#1091=IFCCARTESIANPOINT((3000.,0.));

#110=IFCWALL('0aaaaaaaaaaaaaaaaaaac2',$,'Wall G2',$,$,#111,#112,$,.STANDARD.);
#111=IFCLOCALPLACEMENT(#51,#1111);
#1111=IFCAXIS2PLACEMENT3D(#1112,#31,#33);
#1112=IFCCARTESIANPOINT((6000.,0.,0.));
#112=IFCPRODUCTDEFINITIONSHAPE($,$,(#113,#116));
#113=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#114));
#114=IFCPOLYLINE((#105,#1141));
#1141=IFCCARTESIANPOINT((4000.,0.));
#116=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#117));
#117=IFCEXTRUDEDAREASOLID(#118,#21,#31,3000.);
#118=IFCRECTANGLEPROFILEDEF(.AREA.,$,#119,4000.,200.);
#119=IFCAXIS2PLACEMENT2D(#1191,$);
#1191=IFCCARTESIANPOINT((2000.,0.));

#120=IFCWALL('0aaaaaaaaaaaaaaaaaaac3',$,'Wall G3',$,$,#121,#102,$,.STANDARD.);
#121=IFCLOCALPLACEMENT(#51,#1211);
#1211=IFCAXIS2PLACEMENT3D(#1212,#31,#34);
#1212=IFCCARTESIANPOINT((6000.,4000.,0.));

#130=IFCWALL('0aaaaaaaaaaaaaaaaaaac4',$,'Wall G4',$,$,#131,#112,$,.STANDARD.);
#131=IFCLOCALPLACEMENT(#51,#1311);
#1311=IFCAXIS2PLACEMENT3D(#1312,#31,#35);
#1312=IFCCARTESIANPOINT((0.,4000.,0.));

/* Upper walls: 6000x4000, 3000 tall, 200 thick */
#140=IFCWALL('0aaaaaaaaaaaaaaaaaaac5',$,'Wall U1',$,$,#53,#102,$,.STANDARD.);
#150=IFCWALL('0aaaaaaaaaaaaaaaaaaac6',$,'Wall U2',$,$,#151,#112,$,.STANDARD.);
#151=IFCLOCALPLACEMENT(#53,#1111);
#160=IFCWALL('0aaaaaaaaaaaaaaaaaaac7',$,'Wall U3',$,$,#161,#102,$,.STANDARD.);
#161=IFCLOCALPLACEMENT(#53,#1211);
#170=IFCWALL('0aaaaaaaaaaaaaaaaaaac8',$,'Wall U4',$,$,#171,#112,$,.STANDARD.);
#171=IFCLOCALPLACEMENT(#53,#1311);

/* Roof: aggregates two IfcSlab (.ROOF.) forming a gable */
#200=IFCROOF('0aaaaaaaaaaaaaaaaaaar1',$,'Gable Roof',$,$,#53,$,$,.GABLE_ROOF.);
#201=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaar2',$,$,$,#200,(#210,#220));

/* Slab 1 (South slope): ridge Y=2000, eave Y=0, Z=6000..7500, 200 mm thick */
#210=IFCSLAB('0aaaaaaaaaaaaaaaaaaas1',$,'Roof Slab South',$,$,#21,#211,$,.ROOF.);
#211=IFCPRODUCTDEFINITIONSHAPE($,$,(#212));
#212=IFCSHAPEREPRESENTATION(#20,'Body','Brep',(#213));
#213=IFCFACETEDBREP(#214);
#214=IFCCLOSEDSHELL((#231,#232,#233,#234,#235,#236));

/* Slab 2 (North slope): ridge Y=2000, eave Y=4000, Z=6000..7500, 200 mm thick */
#220=IFCSLAB('0aaaaaaaaaaaaaaaaaaas2',$,'Roof Slab North',$,$,#21,#221,$,.ROOF.);
#221=IFCPRODUCTDEFINITIONSHAPE($,$,(#222));
#222=IFCSHAPEREPRESENTATION(#20,'Body','Brep',(#223));
#223=IFCFACETEDBREP(#224);
#224=IFCCLOSEDSHELL((#241,#242,#243,#244,#245,#246));

/* Vertices for Slab 1 (South): bottom z 6000..7300, top z 6200..7500 */
#2501=IFCCARTESIANPOINT((0.,0.,6000.));
#2502=IFCCARTESIANPOINT((6000.,0.,6000.));
#2503=IFCCARTESIANPOINT((6000.,2000.,7300.));
#2504=IFCCARTESIANPOINT((0.,2000.,7300.));
#2505=IFCCARTESIANPOINT((0.,0.,6200.));
#2506=IFCCARTESIANPOINT((6000.,0.,6200.));
#2507=IFCCARTESIANPOINT((6000.,2000.,7500.));
#2508=IFCCARTESIANPOINT((0.,2000.,7500.));

/* 6 faces for Slab 1 */
#231=IFCFACE((#2311));
#2311=IFCFACEOUTERBOUND(#2312,.T.);
#2312=IFCPOLYLOOP((#2501,#2504,#2503,#2502));
#232=IFCFACE((#2321));
#2321=IFCFACEOUTERBOUND(#2322,.T.);
#2322=IFCPOLYLOOP((#2505,#2506,#2507,#2508));
#233=IFCFACE((#2331));
#2331=IFCFACEOUTERBOUND(#2332,.T.);
#2332=IFCPOLYLOOP((#2501,#2502,#2506,#2505));
#234=IFCFACE((#2341));
#2341=IFCFACEOUTERBOUND(#2342,.T.);
#2342=IFCPOLYLOOP((#2503,#2504,#2508,#2507));
#235=IFCFACE((#2351));
#2351=IFCFACEOUTERBOUND(#2352,.T.);
#2352=IFCPOLYLOOP((#2501,#2505,#2508,#2504));
#236=IFCFACE((#2361));
#2361=IFCFACEOUTERBOUND(#2362,.T.);
#2362=IFCPOLYLOOP((#2502,#2503,#2507,#2506));

/* Vertices for Slab 2 (North): bottom z 6000..7300, top z 6200..7500 */
#2601=IFCCARTESIANPOINT((0.,2000.,7300.));
#2602=IFCCARTESIANPOINT((6000.,2000.,7300.));
#2603=IFCCARTESIANPOINT((6000.,4000.,6000.));
#2604=IFCCARTESIANPOINT((0.,4000.,6000.));
#2605=IFCCARTESIANPOINT((0.,2000.,7500.));
#2606=IFCCARTESIANPOINT((6000.,2000.,7500.));
#2607=IFCCARTESIANPOINT((6000.,4000.,6200.));
#2608=IFCCARTESIANPOINT((0.,4000.,6200.));

/* 6 faces for Slab 2 */
#241=IFCFACE((#2411));
#2411=IFCFACEOUTERBOUND(#2412,.T.);
#2412=IFCPOLYLOOP((#2601,#2604,#2603,#2602));
#242=IFCFACE((#2421));
#2421=IFCFACEOUTERBOUND(#2422,.T.);
#2422=IFCPOLYLOOP((#2605,#2606,#2607,#2608));
#243=IFCFACE((#2431));
#2431=IFCFACEOUTERBOUND(#2432,.T.);
#2432=IFCPOLYLOOP((#2601,#2602,#2606,#2605));
#244=IFCFACE((#2441));
#2441=IFCFACEOUTERBOUND(#2442,.T.);
#2442=IFCPOLYLOOP((#2603,#2604,#2608,#2607));
#245=IFCFACE((#2451));
#2451=IFCFACEOUTERBOUND(#2452,.T.);
#2452=IFCPOLYLOOP((#2601,#2605,#2608,#2604));
#246=IFCFACE((#2461));
#2461=IFCFACEOUTERBOUND(#2462,.T.);
#2462=IFCPOLYLOOP((#2602,#2603,#2607,#2606));

/* Stair on Ground: quarter-turn stair aggregating 2 flights, 1 landing, 1 railing */
#300=IFCSTAIR('0aaaaaaaaaaaaaaaaaaat1',$,'Main Stair',$,$,#51,$,$,.QUARTER_TURN_STAIR.);
#301=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaat2',$,$,$,#300,(#310,#320,#330,#340));

/* Flight 1: climbs toward +X from x=500..3000 at y=500..1500, Z=0..1500 */
#310=IFCSTAIRFLIGHT('0aaaaaaaaaaaaaaaaaaaf1',$,'Flight 1',$,$,#51,#311,$,9,8,166.7,280.,.STRAIGHT.);
#311=IFCPRODUCTDEFINITIONSHAPE($,$,(#312));
#312=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#313,#316));
#313=IFCEXTRUDEDAREASOLID(#314,#21,#31,750.);
#314=IFCRECTANGLEPROFILEDEF(.AREA.,$,#315,1250.,1000.);
#315=IFCAXIS2PLACEMENT2D(#3151,$);
#3151=IFCCARTESIANPOINT((1125.,1000.));
#316=IFCEXTRUDEDAREASOLID(#317,#21,#31,1500.);
#317=IFCRECTANGLEPROFILEDEF(.AREA.,$,#318,1250.,1000.);
#318=IFCAXIS2PLACEMENT2D(#3181,$);
#3181=IFCCARTESIANPOINT((2375.,1000.));

/* Flight 2: climbs toward +Y from y=1500..4000 at x=3000..4000, Z=1500..3000 */
#320=IFCSTAIRFLIGHT('0aaaaaaaaaaaaaaaaaaaf2',$,'Flight 2',$,$,#51,#321,$,9,8,166.7,280.,.STRAIGHT.);
#321=IFCPRODUCTDEFINITIONSHAPE($,$,(#322));
#322=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#323,#326));
#323=IFCEXTRUDEDAREASOLID(#324,#3251,#31,750.);
#324=IFCRECTANGLEPROFILEDEF(.AREA.,$,#325,1000.,1250.);
#325=IFCAXIS2PLACEMENT2D(#3252,$);
#3251=IFCAXIS2PLACEMENT3D(#3253,$,$);
#3252=IFCCARTESIANPOINT((3500.,2125.));
#3253=IFCCARTESIANPOINT((0.,0.,1500.));
#326=IFCEXTRUDEDAREASOLID(#327,#3251,#31,1500.);
#327=IFCRECTANGLEPROFILEDEF(.AREA.,$,#328,1000.,1250.);
#328=IFCAXIS2PLACEMENT2D(#3281,$);
#3281=IFCCARTESIANPOINT((3500.,3375.));

/* Landing at x=3000..4000, y=500..1500, Z=1300..1500 */
#330=IFCSLAB('0aaaaaaaaaaaaaaaaaaal1',$,'Landing',$,$,#51,#331,$,.LANDING.);
#331=IFCPRODUCTDEFINITIONSHAPE($,$,(#332));
#332=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#333));
#333=IFCEXTRUDEDAREASOLID(#334,#3351,#31,200.);
#334=IFCRECTANGLEPROFILEDEF(.AREA.,$,#335,1000.,1000.);
#335=IFCAXIS2PLACEMENT2D(#3352,$);
#3351=IFCAXIS2PLACEMENT3D(#3353,$,$);
#3352=IFCCARTESIANPOINT((3500.,1000.));
#3353=IFCCARTESIANPOINT((0.,0.,1300.));

/* Railing */
#340=IFCRAILING('0aaaaaaaaaaaaaaaaaaam1',$,'Stair Railing',$,$,#51,#341,$,.HANDRAIL.);
#341=IFCPRODUCTDEFINITIONSHAPE($,$,(#342));
#342=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#343));
#343=IFCEXTRUDEDAREASOLID(#344,#21,#31,1000.);
#344=IFCRECTANGLEPROFILEDEF(.AREA.,$,#345,2500.,50.);
#345=IFCAXIS2PLACEMENT2D(#3451,$);
#3451=IFCCARTESIANPOINT((1750.,500.));

ENDSEC;
END-ISO-10303-21;
