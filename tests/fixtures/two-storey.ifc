#137=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#138,#139);
#138=IFCEXTRUDEDAREASOLID(#118,#21,#31,2700.);
#139=IFCHALFSPACESOLID(#1391,.F.);
#1391=IFCPLANE(#21);
#150=IFCMATERIALLAYER($,300.,$,$,$,$,$);
#151=IFCMATERIALLAYERSET((#150),'300 mm',$);
#152=IFCMATERIALLAYERSETUSAGE(#151,.AXIS2.,.POSITIVE.,-150.,$);
#153=IFCRELASSOCIATESMATERIAL('0aaaaaaaaaaaaaaaaaaad1',$,$,$,(#130),#152);
/* door in wall 1: centre at 1450 mm, 900 x 2100 */
#300=IFCDOOR('0aaaaaaaaaaaaaaaaaaae1',$,'Front door',$,$,#301,$,$,2100.,900.,.DOOR.,.SINGLE_SWING_LEFT.,$);
#301=IFCLOCALPLACEMENT(#101,#21);
#302=IFCOPENINGELEMENT('0aaaaaaaaaaaaaaaaaaae2',$,'Opening',$,$,#303,#304,$,.OPENING.);
