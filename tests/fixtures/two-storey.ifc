#1293=IFCCARTESIANPOINT((0.,4100.));
#1294=IFCCARTESIANPOINT((0.,3900.));
/* wall 4: (0,4000) -> (0,0), thickness from material layers (300 mm), axis only body is a clipped extrusion */
#130=IFCWALL('0aaaaaaaaaaaaaaaaaaac4',$,'Wall 4',$,$,#131,#132,$,.STANDARD.);
#131=IFCLOCALPLACEMENT(#51,#1311);
#1311=IFCAXIS2PLACEMENT3D(#1312,#31,#35);
