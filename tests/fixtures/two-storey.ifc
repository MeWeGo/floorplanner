#5062=IFCCARTESIANPOINT((5900.,100.));
#5063=IFCCARTESIANPOINT((5900.,3900.));
#5064=IFCCARTESIANPOINT((3000.,3900.));
#5065=IFCCARTESIANPOINT((3000.,2000.));
#5066=IFCCARTESIANPOINT((100.,2000.));
/* ground slab and a roof (skipped) */
#600=IFCSLAB('0aaaaaaaaaaaaaaaaaaah1',$,'Floor slab',$,$,#601,#602,$,.FLOOR.);
#601=IFCLOCALPLACEMENT(#51,#6011);
#6011=IFCAXIS2PLACEMENT3D(#6012,$,$);
