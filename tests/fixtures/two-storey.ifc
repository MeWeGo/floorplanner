#3091=IFCRELFILLSELEMENT('0aaaaaaaaaaaaaaaaaaae4',$,$,$,#302,#300);
/* window in wall 2: centre 2100 mm along the wall, 1200 wide, sill 900, 1200 high */
#310=IFCWINDOW('0aaaaaaaaaaaaaaaaaaaf1',$,'Window',$,$,#111,$,$,1200.,1200.,.WINDOW.,$,$);
#312=IFCOPENINGELEMENT('0aaaaaaaaaaaaaaaaaaaf2',$,'Opening',$,$,#313,#314,$,.OPENING.);
#313=IFCLOCALPLACEMENT(#111,#3131);
#3131=IFCAXIS2PLACEMENT3D(#3132,$,$);
#3132=IFCCARTESIANPOINT((0.,0.,900.));
#314=IFCPRODUCTDEFINITIONSHAPE($,$,(#315));
#315=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#316));
#316=IFCEXTRUDEDAREASOLID(#317,#21,#31,1200.);
#317=IFCRECTANGLEPROFILEDEF(.AREA.,$,#318,1200.,400.);
#318=IFCAXIS2PLACEMENT2D(#3181,$);
#3181=IFCCARTESIANPOINT((2100.,0.));
#319=IFCRELVOIDSELEMENT('0aaaaaaaaaaaaaaaaaaaf3',$,$,$,#110,#312);
#3191=IFCRELFILLSELEMENT('0aaaaaaaaaaaaaaaaaaaf4',$,$,$,#312,#310);
/* space (aggregated into Level 1) */
#500=IFCSPACE('0aaaaaaaaaaaaaaaaaaag1',$,'101',$,$,#501,#502,'Living Room',.ELEMENT.,.SPACE.,$);
#501=IFCLOCALPLACEMENT(#51,#21);
#502=IFCPRODUCTDEFINITIONSHAPE($,$,(#503));
#503=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#504));
#504=IFCEXTRUDEDAREASOLID(#505,#21,#31,2700.);
#505=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#506);
#506=IFCPOLYLINE((#5061,#5062,#5063,#5064,#5065,#5066,#5061));
