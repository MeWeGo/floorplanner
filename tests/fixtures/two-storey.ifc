#700=IFCSLAB('0aaaaaaaaaaaaaaaaaaah2',$,'Roof',$,$,#53,#602,$,.ROOF.);
/* level 2: one wall and a slab with a stair opening */
#140=IFCWALL('0aaaaaaaaaaaaaaaaaaac5',$,'Wall 5',$,$,#141,#102,$,.STANDARD.);
