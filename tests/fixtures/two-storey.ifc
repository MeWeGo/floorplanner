#119=IFCAXIS2PLACEMENT2D(#1191,$);
#1191=IFCCARTESIANPOINT((2000.,0.));
/* wall 3: (6000,4000) -> (0,4000), body as arbitrary polygon, no axis */
#120=IFCWALL('0aaaaaaaaaaaaaaaaaaac3',$,'Wall 3',$,$,#101,#122,$,.STANDARD.);
#122=IFCPRODUCTDEFINITIONSHAPE($,$,(#126));
#126=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#127));
