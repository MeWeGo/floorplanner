/* wall 2: (6000,0) -> (6000,4000) */
#110=IFCWALL('0aaaaaaaaaaaaaaaaaaac2',$,'Wall 2',$,$,#111,#112,$,.STANDARD.);
#111=IFCLOCALPLACEMENT(#51,#1111);
