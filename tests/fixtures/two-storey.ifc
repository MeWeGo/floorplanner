#64=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab1',$,$,$,(#100,#110,#120,#130,#300,#310,#600),#50);
#65=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaab2',$,$,$,(#140,#700),#52);
/* wall 1: (0,0) -> (6000,0), local x = world X */
#100=IFCWALL('0aaaaaaaaaaaaaaaaaaac1',$,'Wall 1',$,$,#101,#102,$,.STANDARD.);
#101=IFCLOCALPLACEMENT(#51,#21);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103,#106));
