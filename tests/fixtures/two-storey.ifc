ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('two-storey.ifc','2026-11-07T00:00:00',(''),(''),'hand-written test fixture','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* units: millimetre, radian */
#1=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaa1',$,'Test House',$,$,'Test House \X2\00C7\X0\ati',$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12));
