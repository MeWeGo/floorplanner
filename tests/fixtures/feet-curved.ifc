ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView_V2.0]'),'2;1');
FILE_NAME('feet-curved.ifc','2026-11-07T00:00:00',(''),(''),'hand-written test fixture','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
/* units: foot (via IfcConversionBasedUnit) and degree */
#1=IFCPROJECT('1aaaaaaaaaaaaaaaaaaaa1',$,'Feet Studio',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#14));
#9=IFCDIMENSIONALEXPONENTS(0,0,0,0,0,0,0);
#11=IFCCONVERSIONBASEDUNIT(#9,.LENGTHUNIT.,'FOOT',#12);
#12=IFCMEASUREWITHUNIT(IFCRATIOMEASURE(0.3048),#13);
#13=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#14=IFCCONVERSIONBASEDUNIT(#9,.PLANEANGLEUNIT.,'DEGREE',#15);
#15=IFCMEASUREWITHUNIT(IFCPLANEANGLEMEASURE(0.0174532925199433),#16);
#16=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#30,$,$);
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCDIRECTION((0.,0.,1.));
#32=IFCDIRECTION((1.,0.,0.));
#50=IFCBUILDINGSTOREY('1aaaaaaaaaaaaaaaaaaaa4',$,'Ground',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT($,#21);
#64=IFCRELCONTAINEDINSPATIALSTRUCTURE('1aaaaaaaaaaaaaaaaaaab1',$,$,$,(#100,#110,#200,#300,#500),#50);
/* curved wall: quarter circle r = 10 ft from 0 to 90 degrees, thickness from material layers (1 ft) */
#100=IFCWALL('1aaaaaaaaaaaaaaaaaaac1',$,'Curved wall',$,$,#51,#102,$);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103,#106));
#103=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#104));
#104=IFCTRIMMEDCURVE(#105,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(90.)),.T.,.PARAMETER.);
#105=IFCCIRCLE(#1051,10.);
#1051=IFCAXIS2PLACEMENT2D(#1052,$);
#1052=IFCCARTESIANPOINT((0.,0.));
#106=IFCSHAPEREPRESENTATION(#20,'Box','BoundingBox',(#107));
#107=IFCBOUNDINGBOX(#30,10.5,10.5,9.);
#150=IFCMATERIALLAYER($,1.,$);
#151=IFCMATERIALLAYERSET((#150),'Brick 1ft');
#152=IFCMATERIALLAYERSETUSAGE(#151,.AXIS2.,.POSITIVE.,-0.5);
#153=IFCRELASSOCIATESMATERIAL('1aaaaaaaaaaaaaaaaaaad1',$,$,$,(#100),#152);
/* straight wall: (0,10) -> (-20,10) ft, 0.5 ft thick */
#110=IFCWALLSTANDARDCASE('1aaaaaaaaaaaaaaaaaaac2',$,'Straight wall',$,$,#111,#112,$);
#111=IFCLOCALPLACEMENT(#51,#1111);
#1111=IFCAXIS2PLACEMENT3D(#1112,#31,#1113);
#1112=IFCCARTESIANPOINT((0.,10.,0.));
#1113=IFCDIRECTION((-1.,0.,0.));
#112=IFCPRODUCTDEFINITIONSHAPE($,$,(#113,#116));
#113=IFCSHAPEREPRESENTATION(#20,'Axis','Curve2D',(#114));
#114=IFCPOLYLINE((#1052,#1141));
#1141=IFCCARTESIANPOINT((20.,0.));
#116=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#117));
#117=IFCEXTRUDEDAREASOLID(#118,#21,#31,9.);
#118=IFCRECTANGLEPROFILEDEF(.AREA.,$,#119,20.,0.5);
#119=IFCAXIS2PLACEMENT2D(#1191,$);
#1191=IFCCARTESIANPOINT((10.,0.));
/* curtain wall without own geometry: one plate aggregated, along x = 10 ft from y = 0 to y = -15 */
#200=IFCCURTAINWALL('1aaaaaaaaaaaaaaaaaaae1',$,'Curtain wall',$,$,#51,$,$);
#201=IFCRELAGGREGATES('1aaaaaaaaaaaaaaaaaaae2',$,$,$,#200,(#202));
#202=IFCPLATE('1aaaaaaaaaaaaaaaaaaae3',$,'Panel',$,$,#51,#203,$);
#203=IFCPRODUCTDEFINITIONSHAPE($,$,(#204));
#204=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#205));
#205=IFCEXTRUDEDAREASOLID(#206,#21,#31,9.);
#206=IFCRECTANGLEPROFILEDEF(.AREA.,$,#207,0.2,15.);
#207=IFCAXIS2PLACEMENT2D(#2071,$);
#2071=IFCCARTESIANPOINT((10.,-7.5));
/* door with a mapped brep and no opening / fill relationship: centred 10 ft along the straight wall, 3 ft x 7 ft */
#300=IFCDOOR('1aaaaaaaaaaaaaaaaaaaf1',$,'Door',$,$,#301,#302,$,7.,3.);
#301=IFCLOCALPLACEMENT(#51,#3011);
#3011=IFCAXIS2PLACEMENT3D(#3012,$,$);
#3012=IFCCARTESIANPOINT((-10.,10.,0.));
#302=IFCPRODUCTDEFINITIONSHAPE($,$,(#303));
#303=IFCSHAPEREPRESENTATION(#20,'Body','MappedRepresentation',(#304));
#304=IFCMAPPEDITEM(#305,#306);
#305=IFCREPRESENTATIONMAP(#21,#307);
#306=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#30,1.,$);
#307=IFCSHAPEREPRESENTATION(#20,'Body','Brep',(#308));
#308=IFCFACETEDBREP(#309);
#309=IFCCLOSEDSHELL((#310,#311));
#310=IFCFACE((#312));
#311=IFCFACE((#313));
#312=IFCFACEOUTERBOUND(#314,.T.);
#313=IFCFACEOUTERBOUND(#315,.T.);
#314=IFCPOLYLOOP((#320,#321,#322,#323));
#315=IFCPOLYLOOP((#324,#325,#326,#327));
#320=IFCCARTESIANPOINT((-1.5,-0.25,0.));
#321=IFCCARTESIANPOINT((1.5,-0.25,0.));
#322=IFCCARTESIANPOINT((1.5,0.25,0.));
#323=IFCCARTESIANPOINT((-1.5,0.25,0.));
#324=IFCCARTESIANPOINT((-1.5,-0.25,7.));
#325=IFCCARTESIANPOINT((1.5,-0.25,7.));
#326=IFCCARTESIANPOINT((1.5,0.25,7.));
#327=IFCCARTESIANPOINT((-1.5,0.25,7.));
/* brep space: bottom face is an L shape, name only */
#500=IFCSPACE('1aaaaaaaaaaaaaaaaaaag1',$,'Kitchen',$,$,#51,#502,$,.ELEMENT.,.INTERNAL.,$);
#502=IFCPRODUCTDEFINITIONSHAPE($,$,(#503));
#503=IFCSHAPEREPRESENTATION(#20,'Body','Brep',(#504));
#504=IFCFACETEDBREP(#505);
#505=IFCCLOSEDSHELL((#506,#507));
#506=IFCFACE((#508));
#507=IFCFACE((#509));
#508=IFCFACEOUTERBOUND(#510,.T.);
#509=IFCFACEOUTERBOUND(#511,.T.);
#510=IFCPOLYLOOP((#520,#521,#522,#523,#524,#525));
#511=IFCPOLYLOOP((#530,#531,#532));
#520=IFCCARTESIANPOINT((-20.,10.,0.));
#521=IFCCARTESIANPOINT((-20.,20.,0.));
#522=IFCCARTESIANPOINT((0.,20.,0.));
#523=IFCCARTESIANPOINT((0.,15.,0.));
#524=IFCCARTESIANPOINT((-10.,15.,0.));
#525=IFCCARTESIANPOINT((-10.,10.,0.));
#530=IFCCARTESIANPOINT((-20.,10.,9.));
#531=IFCCARTESIANPOINT((-20.,20.,9.));
#532=IFCCARTESIANPOINT((0.,20.,9.));
ENDSEC;
